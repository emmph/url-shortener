# === Database (PostgreSQL in Docker/K8s, or SQLite for local trial without Docker) ===
POSTGRES_DB=url_shortener
POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=change_me_strong_postgres_password
DATABASE_URL=postgresql+asyncpg://url_shortener:change_me_strong_postgres_password@postgres:5432/url_shortener

# === Redis ===
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=128mb

# === Application ===
APP_NAME=URL Shortener
BASE_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# === Security & Privacy ===
IP_HASH_SALT=change_me_long_random_salt_for_daily_ip_hash
# Argon2id password hash or plain password for dev fallback (prefer ADMIN_PASSWORD_HASH in prod)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=change_me_super_secret_jwt_key_at_least_32_bytes
JWT_EXPIRE_MINUTES=120
COOKIE_SECURE=false

# === Limits & Anti-Abuse ===
MAX_CUSTOM_CLICKS=250
SHORT_CODE_LENGTH=7
RATE_LIMIT_CREATE_PER_MIN=30
BRUTEFORCE_404_THRESHOLD=30
BRUTEFORCE_404_WINDOW_SEC=60
BRUTEFORCE_404_BLOCK_SEC=300
ADMIN_LOCKOUT_ATTEMPTS=5
ADMIN_LOCKOUT_SECONDS=900

# === CVE & Security Scanner ===
SCANNER_TIMEOUT_SECONDS=10
SCANNER_ESTIMATED_SECONDS=15
SCANNER_MAX_BYTES=65536
SCANNER_MAX_REDIRECTS=5
MAX_SCAN_QUEUE_SIZE=5000
SCANNER_MIN_BLOCK_CVSS=4.0
SCANNER_CONCURRENCY=10
OSV_API_URL=https://api.osv.dev/v1/query
NVD_API_KEY=

# === Write-Behind Analytics Flusher & Embedded Worker ===
ANALYTICS_FLUSH_INTERVAL=3
ANALYTICS_BATCH_SIZE=500
RUN_EMBEDDED_WORKER=true
ALLOW_MEMORY_FALLBACK=false
SERVE_FRONTEND_DIST=false
